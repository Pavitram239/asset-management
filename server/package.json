    "express-validator": "^7.0.1",
    "firebase-admin": "^14.5.0",
    "http-status-codes": "^2.2.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^2.4.0",
